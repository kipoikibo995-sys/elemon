{
  "_doc": "Motion for baby / child / teen sheets (4x4: idle x4, walk x4, eat happy tired sick, sleep x2 yawn flex). eat, happy, refuse, petted, wave, sad, angry use the extra sheet (slice_frames.py LAYOUTS['extra']); a stage without one gets _eat_1khung / _happy_1khung and none of the others (creatures.anims_path). Same key format as adult.json.",
  "idle":   {"loop": true,  "keys": [{"f": "idle-0", "ms": 800, "br": 1}, {"f": "idle-1", "ms": 800, "br": 0},
                                     {"f": "idle-2", "ms": 800, "br": 1}, {"f": "idle-3", "ms": 800, "br": 0}]},
  "walk":   {"loop": true,  "keys": [{"f": "walk-0", "ms": 150, "y": -1}, {"f": "walk-1", "ms": 150, "y": 0},
                                     {"f": "walk-2", "ms": 150, "y": -1}, {"f": "walk-3", "ms": 150, "y": 0}]},
  "eat":    {"loop": true,  "keys": [{"f": "eat-look", "ms": 260, "br": 0}, {"f": "eat-bite", "ms": 160, "br": -1},
                                     {"f": "eat-chew", "ms": 200, "br": 1}, {"f": "eat-chew", "ms": 200, "br": -1},
                                     {"f": "eat-bite", "ms": 160, "br": -1}, {"f": "eat-chew", "ms": 200, "br": 1},
                                     {"f": "eat-chew", "ms": 180, "br": -1}, {"f": "eat-lick", "ms": 420, "br": 0}]},
  "happy":  {"loop": true,  "keys": [{"f": "play-crouch", "ms": 170, "br": -1}, {"f": "play-jump", "ms": 110, "y": -10},
                                     {"f": "play-air", "ms": 130, "y": -20}, {"f": "play-spin", "ms": 150, "y": -24},
                                     {"f": "play-air", "ms": 120, "y": -12}, {"f": "play-land", "ms": 150, "y": 0, "br": -1},
                                     {"f": "play-cheer", "ms": 220, "br": 1}, {"f": "play-cheer", "ms": 180, "y": -4, "br": 0},
                                     {"f": "play-cheer", "ms": 220, "y": 0, "br": 1}]},
  "refuse": {"loop": false, "keys": [{"f": "refuse", "ms": 140, "x": -2}, {"f": "refuse", "ms": 140, "x": 2},
                                     {"f": "refuse", "ms": 140, "x": -2}, {"f": "refuse", "ms": 140, "x": 1},
                                     {"f": "refuse", "ms": 500, "x": 0}, {"f": "idle-0", "ms": 200}]},
  "petted": {"loop": true,  "keys": [{"f": "petted", "ms": 500, "br": 1}, {"f": "petted", "ms": 500, "br": -1}]},
  "wave":   {"loop": true,  "keys": [{"f": "wave", "ms": 220, "br": 1}, {"f": "wave", "ms": 220, "br": 0},
                                     {"f": "wave", "ms": 220, "br": 1}, {"f": "idle-0", "ms": 300, "br": 0}]},
  "sad":    {"loop": true,  "keys": [{"f": "sad", "ms": 1400, "br": -1}, {"f": "sad", "ms": 1400, "br": 0}]},
  "angry":  {"loop": true,  "keys": [{"f": "angry", "ms": 120, "y": -3}, {"f": "angry", "ms": 120, "y": 0, "br": -1},
                                     {"f": "angry", "ms": 120, "y": -3}, {"f": "angry", "ms": 120, "y": 0, "br": -1},
                                     {"f": "angry", "ms": 700, "br": 1}]},
  "_eat_1khung": {"loop": true,  "keys": [{"f": "eat", "ms": 180, "br": -1}, {"f": "eat", "ms": 180, "br": 1},
                                     {"f": "eat", "ms": 180, "br": -1}, {"f": "eat", "ms": 380, "br": 0}]},
  "_happy_1khung": {"loop": true,  "keys": [{"f": "idle-0", "ms": 140, "br": -1}, {"f": "jump-happy", "ms": 200, "y": -16},
                                     {"f": "jump-happy", "ms": 180, "y": 0}, {"f": "idle-0", "ms": 120, "br": -1},
                                     {"f": "idle-0", "ms": 260, "br": 0}]},
  "tired":  {"loop": true,  "keys": [{"f": "tired", "ms": 1300, "br": 1}, {"f": "tired", "ms": 1300, "br": 0}]},
  "sick":   {"loop": true,  "keys": [{"f": "sick", "ms": 500, "x": -1}, {"f": "sick", "ms": 500, "x": 1}]},
  "sleep":  {"loop": true,  "keys": [{"f": "sleep-0", "ms": 1100, "br": 1}, {"f": "sleep-1", "ms": 1100, "br": 0}]},
  "wake":   {"loop": false, "keys": [{"f": "sleep-1", "ms": 500}, {"f": "yawn", "ms": 300, "br": 1},
                                     {"f": "yawn", "ms": 600, "br": 1}, {"f": "flex", "ms": 200, "br": 2},
                                     {"f": "flex", "ms": 500, "br": 0}, {"f": "idle-0", "ms": 300}]}
}
